# Mode: instance (local SQLite) or console (Postgres). Default: console
FRAME_MODE=console

# Console (Postgres)
DATABASE_URL=postgresql://user:password@host:5432/database

# Instance (SQLite)
FRAME_DATA_DIR=/var/lib/frame
FRAME_DB_PATH=/var/lib/frame/frame.db

# Sync (instance)
SYNC_ENABLED=false
SYNC_ENDPOINT=https://console.example.com
SYNC_TOKEN=
INSTANCE_ID=
SYNC_INTERVAL_MINUTES=15
SYNC_SECRET=
# Optional: exact hosts SYNC_ENDPOINT may use (comma-separated). When unset:
# https anywhere, plain http only on loopback. Enforced by POST /api/sync/run.
SYNC_ALLOWED_HOSTS=

# Console admin
# REQUIRED in production: with no token set, admin-gated APIs fail closed (HTTP 500).
# Compared constant-time against the `x-admin-token` header.
CONSOLE_ADMIN_TOKEN=
# Optional: require this Clerk role for /console and human API access.
CONSOLE_ADMIN_ROLE=

# Instance snapshots (startup + scripts/snapshot.ts); newest N kept
BACKUP_MAX=10

# Asset storage limits (checked by POST /api/assets)
ASSET_MAX_COUNT=5000
ASSET_MAX_TOTAL_BYTES=536870912

# Clerk (console production auth) - optional in dev
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
