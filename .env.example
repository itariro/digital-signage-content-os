# Mode: instance (local SQLite) or console (Postgres). Default: console
FRAME_MODE=console

# Console (Postgres)
DATABASE_URL=postgresql://user:password@host:5432/database

# Instance (SQLite)
FRAME_DATA_DIR=/var/lib/frame
FRAME_DB_PATH=/var/lib/frame/frame.db

# Sync (instance)
SYNC_ENABLED=false
SYNC_ENDPOINT=https://console.example.com
SYNC_TOKEN=
INSTANCE_ID=
SYNC_INTERVAL_MINUTES=15
SYNC_SECRET=

# Console admin (dev mode open if unset)
CONSOLE_ADMIN_TOKEN=

# Clerk (console production auth) - optional in dev
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
